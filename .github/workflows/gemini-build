name: Build Git DMG Installer

on:
  workflow_dispatch: # מאפשר הרצה ידנית של התהליך

jobs:
  build-git-dmg:
    runs-on: macos-13 # תואם לארכיטקטורת Intel ול-macOS Ventura

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Install Build Dependencies
        run: brew install autoconf zlib gettext pcre2

      - name: Download Latest Git Source
        run: |
          # שליפת תגית הגרסה העדכנית ביותר של Git מה-API של GitHub
          LATEST_TAG=$(curl -sL https://api.github.com/repos/git/git/tags | grep -Eo '"name": "v[0-9]+\.[0-9]+\.[0-9]+"' | head -n 1 | cut -d'"' -f4)
          echo "LATEST_TAG=$LATEST_TAG" >> $GITHUB_ENV
          echo "Downloading Git version $LATEST_TAG..."
          
          # הורדת קוד המקור ופתיחתו
          curl -o git-source.tar.gz -L "https://github.com/git/git/archive/refs/tags/${LATEST_TAG}.tar.gz"
          tar -xzf git-source.tar.gz
          mv "git-${LATEST_TAG#v}" git-source

      - name: Compile and Build Git
        run: |
          cd git-source
          make configure
          
          # הגדרת תיקיית יעד זמנית בתוך סביבת הריצה לאיסוף הקבצים המקומפלים
          ./configure --prefix=${{ github.workspace }}/git-dest/usr/local
          
          # קימפול מהיר יותר תוך שימוש בכל ליבות המעבד הזמינות בשרת
          make all -j$(sysctl -n hw.ncpu)
          make install

      - name: Package into PKG and DMG
        run: |
          VERSION_NUM=$(echo ${{ env.LATEST_TAG }} | sed 's/v//')
          
          # 1. יצירת חבילת התקנה (PKG) כדי שמערכת ההפעלה תדע להתקין את הקבצים בנתיב הנכון
          pkgbuild --root ${{ github.workspace }}/git-dest \
                   --identifier com.git.latest.pkg \
                   --version $VERSION_NUM \
                   --install-location / \
                   Git-Installer.pkg
          
          # 2. הכנת תיקייה עבור יצירת ה-DMG
          mkdir dmg_folder
          mv Git-Installer.pkg dmg_folder/
          
          # 3. יצירת קובץ ה-DMG
          hdiutil create -volname "Git_Installer_${VERSION_NUM}" -srcfolder dmg_folder -ov -format UDZO Git-macOS-Installer.dmg

      - name: Upload DMG Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Git-macOS-Installer-Intel
          path: Git-macOS-Installer.dmg
          retention-days: 7
